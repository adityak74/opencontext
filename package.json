{
  "name": "opencontext",
  "version": "0.0.1",
  "description": "Convert ChatGPT conversation exports to Claude-compatible format",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "opencontext": "./dist/index.js",
    "opencontext-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "server": "tsx src/server.ts",
    "server:prod": "node dist/server.js",
    "mcp:server": "tsx src/mcp/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:backends": "vitest run tests/store/backends.test.ts",
    "db": "tsx src/index.ts db"
  },
  "keywords": [
    "chatgpt",
    "claude",
    "conversation",
    "export",
    "converter",
    "ai",
    "mcp",
    "model-context-protocol",
    "database",
    "byodb",
    "postgres",
    "sqlite",
    "mongodb",
    "duckdb"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=25.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "ollama": "^0.6.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@duckdb/node-api": "^1.0.0",
    "@google-cloud/cloud-sql-connector": "^1.0.0",
    "@google-cloud/firestore": "^7.0.0",
    "@libsql/client": "^0.15.0",
    "mongodb": "^6.0.0 || ^7.0.0",
    "mssql": "^11.0.0 || ^12.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "redis": "^5.0.0 || ^6.0.0",
    "surrealdb": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    },
    "@google-cloud/cloud-sql-connector": {
      "optional": true
    },
    "@google-cloud/firestore": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "surrealdb": {
      "optional": true
    }
  }
}
